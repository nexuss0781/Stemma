{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stemma bundled System Apps",
  "type": "object",
  "required": ["version", "apps"],
  "properties": {
    "version": { "const": 1 },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "kind", "trusted", "version", "language", "icon", "splashImage", "launch", "runtime", "persistence", "permissions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "kind": { "const": "system" },
          "trusted": { "const": true },
          "version": { "type": "string" },
          "language": { "const": "TypeScript" },
          "icon": { "type": "string", "pattern": "^/system-apps/" },
          "splashImage": { "type": "string", "pattern": "^/system-apps/" },
          "launch": {
            "type": "object", "required": ["url", "mode", "fullscreen"],
            "properties": { "url": { "type": "string", "pattern": "^/system-apps/" }, "mode": { "const": "same-window" }, "fullscreen": { "const": true } }
          },
          "runtime": {
            "type": "object", "required": ["type", "workingDirectory", "node", "install", "build", "start", "port", "requiredEnvironment"],
            "properties": { "type": { "const": "hosted-system-app" }, "install": { "type": "string" }, "build": { "type": "string" }, "start": { "type": "string" }, "port": { "type": "integer" }, "requiredEnvironment": { "type": "array", "items": { "type": "string" } } }
          },
          "persistence": { "type": "object", "required": ["driver", "scope", "api", "records"], "properties": { "driver": { "const": "postgresql" }, "scope": { "const": "account" } } },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
