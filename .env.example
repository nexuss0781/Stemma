# Copy to .env for local development. Never commit .env or Fayda credentials.
PORT=3000
NODE_ENV=development
# Generate locally with: openssl rand -base64 48
SESSION_SECRET=
# Optional; defaults to the callback URI's origin when Fayda is configured.
APP_ORIGIN=http://localhost:3000
# Production requires a shared Redis session store; local development may omit this.
REDIS_URL=
# Configure these from Stemma's own Fayda Partner Portal registration.
# Issuer is the exact issuer for the selected sandbox or production environment.
FAYDA_ISSUER=
FAYDA_DISCOVERY_URL=
FAYDA_CLIENT_ID=
# Optional if the private JWK already contains the registered kid.
FAYDA_CLIENT_KEY_ID=
# Supply either a mounted private JWK file (recommended) or a JSON private JWK env value.
FAYDA_CLIENT_PRIVATE_JWK_PATH=
FAYDA_CLIENT_PRIVATE_JWK=
# Must exactly match the callback URI registered for this client.
FAYDA_REDIRECT_URI=http://localhost:3000/auth/fayda/callback
# Sign-in-only default: request no profile claims.
FAYDA_SCOPES=openid
# Optional; set only after Fayda confirms the registered client's accepted values.
FAYDA_ACR_VALUES=
FAYDA_UI_LOCALES=
# Fayda's accepted assertion lifetime is client-specific; default is 60 seconds.
FAYDA_ASSERTION_TTL_SECONDS=60
# Only set when the deployment has the corresponding number of trusted proxies.
TRUST_PROXY=0
